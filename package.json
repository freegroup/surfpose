{
  "name": "ocean-kraft-popup",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p jsconfig.json",
    "lint:css": "stylelint \"src/**/*.css\" \"public/themes/**/*.css\"",
    "dev:phone": "HTTPS=1 vite --host",
    "og": "\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --headless --disable-gpu --hide-scrollbars --window-size=1200,630 --screenshot=public/img/og-image.png \"file://$PWD/scripts/og-card.html\"",
    "postinstall": "node scripts/fetch-assets.js",
    "replay": "node scripts/replay.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "stylelint": "^17.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0",
    "mediabunny": "^1.61.3"
  }
}
